import SolidCore.Solidity.Checked
import SolidCore.Witness.Checked

/-! An external call whose target expression contains an internal call (`I(pf(a)).get()`) hoists the internal call out of the callee before the call.

The AST below is generated by `scripts/solc_ast_to_lean_source.py` from:

```solidity
interface I { function get() external view returns (uint); }
contract C { function pf(address a) internal pure returns (address) { return a; } function f(address a) external view returns (uint) { return I(pf(a)).get(); } }
```
-/

namespace SolidCore
namespace Solidity
namespace Witness
namespace InternalCallInExternalTarget

def importedSourceName : String := "InternalCallInExternalTarget.sol"

def importedContractDecl0 : ContractDecl :=
{ kind := ContractKind.interface
  name := "I"
  abstract := false
  bases := []
  items := [(ContractItem.function
  { kind := FunctionKind.function,
    name := some "get",
    visibility := some Visibility.external_,
    mutability := StateMutability.view,
    params := [],
    returns := [{ name := none, ty := Ty.uint 256, location := none }],
    virtual := false,
    override? := none,
    modifiers := [],
    body := none })] }

def importedContractDecl1 : ContractDecl :=
{ kind := ContractKind.contract
  name := "C"
  abstract := false
  bases := []
  items := [(ContractItem.function
  { kind := FunctionKind.function,
    name := some "pf",
    visibility := some Visibility.internal_,
    mutability := StateMutability.pure,
    params := [{ name := some "a", ty := Ty.address false, location := none }],
    returns := [{ name := none, ty := Ty.address false, location := none }],
    virtual := false,
    override? := none,
    modifiers := [],
    body := some (Stmt.block [Stmt.returnValues (some (Expr.ident "a"))]) }), (ContractItem.function
  { kind := FunctionKind.function,
    name := some "f",
    visibility := some Visibility.external_,
    mutability := StateMutability.view,
    params := [{ name := some "a", ty := Ty.address false, location := none }],
    returns := [{ name := none, ty := Ty.uint 256, location := none }],
    virtual := false,
    override? := none,
    modifiers := [],
    body := some (Stmt.block [Stmt.returnValues (some (Expr.call (Expr.member (Expr.call (Expr.typeName (Ty.user ({ segments := ["I"] }))) [Arg.positional (Expr.call (Expr.ident "pf") [Arg.positional (Expr.ident "a")])]) "get") []))]) })] }

def importedContract : ContractDecl :=
  importedContractDecl1

def importedContracts : List ContractDecl :=
  [importedContractDecl0, importedContractDecl1]

def importedSourceUnit : SourceUnit :=
  { items := [SourceItem.pragma "solidity" "^0.8.0", SourceItem.contract importedContractDecl0, SourceItem.contract importedContractDecl1] }

def importedContractAccepted : Bool :=
  TypeCheck.Result.isOk (TypeCheck.TypecheckedInput.checkedSourceUnit importedSourceUnit)


open SolidCore.Solidity.Source (Value CallResult ScriptedResponder LowLevelCallKind
  LowLevelCallResult State wordEq Word responderOfResults)

def accepted : Bool :=
  TypeCheck.Result.isOk (TypeCheck.TypecheckedInput.checkedSourceUnit importedSourceUnit)

def callC (fn : String) (args : List Value) (responder : ScriptedResponder := []) :
    Except TypeCheck.TypeError CallResult := do
  let program ← TypeCheck.CheckedInput.program importedSourceUnit
  let contract ← TypeCheck.CheckedProgram.contract program "C"
  TypeCheck.CheckedContract.callFunctionWithContextFailOpen 64 responder contract fn
    contract.core.context State.empty args

def returnsWords (r : Except TypeCheck.TypeError CallResult) (expected : List Word) : Bool :=
  match r with
  | .ok (CallResult.returned _ vs) =>
      vs.length == expected.length &&
        (vs.zip expected).all (fun (v, e) =>
          match Value.asWord? v with
          | some w => wordEq w e
          | none => false)
  | _ => false

def reverts (r : Except TypeCheck.TypeError CallResult) : Bool :=
  match r with
  | .ok (CallResult.reverted _ _) => true
  | _ => false

def row (kind : LowLevelCallKind) (sig : String) (tys : List Source.Ty) (args : List Value)
    (outTys : List Source.Ty) (out : List Value) : Except TypeCheck.TypeError LowLevelCallResult := do
  let output ← TypeCheck.Examples.checkedAbiEncodeValues outTys out
  TypeCheck.Examples.checkedHighLevelExternalResult kind sig tys args output

def runWith : Except TypeCheck.TypeError CallResult := do
  let get ← row LowLevelCallKind.staticcall "get()" [] [] [Source.Ty.uint256] [Value.word 77]
  callC "f" [Value.word 0xbeef] (responderOfResults [get] [])

#guard accepted
#guard returnsWords runWith [77]

end InternalCallInExternalTarget
end Witness
end Solidity
end SolidCore
