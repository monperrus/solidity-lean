import SolidCore.Solidity.Checked
import SolidCore.Witness.Checked

/-! An expression statement that is a high-level external call with declared returns (`I(t).get();`) lowers by binding the discarded results, so the return data is still decoded: a too-short answer reverts, as on the EVM. Two discarded calls in one block reuse the hoist temp names.

The AST below is generated by `scripts/solc_ast_to_lean_source.py` from:

```solidity
interface I { function get() external returns (uint); function pair() external returns (uint, uint); }
contract C { function f(address t) external returns (uint) { I(t).get(); I(t).pair(); return 7; } }
```
-/

namespace SolidCore
namespace Solidity
namespace Witness
namespace DiscardedExternalReturn

def importedSourceName : String := "DiscardedExternalReturn.sol"

def importedContractDecl0 : ContractDecl :=
{ kind := ContractKind.interface
  name := "I"
  abstract := false
  bases := []
  items := [(ContractItem.function
  { kind := FunctionKind.function,
    name := some "get",
    visibility := some Visibility.external_,
    mutability := StateMutability.nonpayable,
    params := [],
    returns := [{ name := none, ty := Ty.uint 256, location := none }],
    virtual := false,
    override? := none,
    modifiers := [],
    body := none }), (ContractItem.function
  { kind := FunctionKind.function,
    name := some "pair",
    visibility := some Visibility.external_,
    mutability := StateMutability.nonpayable,
    params := [],
    returns := [{ name := none, ty := Ty.uint 256, location := none }, { name := none, ty := Ty.uint 256, location := none }],
    virtual := false,
    override? := none,
    modifiers := [],
    body := none })] }

def importedContractDecl1 : ContractDecl :=
{ kind := ContractKind.contract
  name := "C"
  abstract := false
  bases := []
  items := [(ContractItem.function
  { kind := FunctionKind.function,
    name := some "f",
    visibility := some Visibility.external_,
    mutability := StateMutability.nonpayable,
    params := [{ name := some "t", ty := Ty.address false, location := none }],
    returns := [{ name := none, ty := Ty.uint 256, location := none }],
    virtual := false,
    override? := none,
    modifiers := [],
    body := some (Stmt.block [Stmt.expr (Expr.call (Expr.member (Expr.call (Expr.typeName (Ty.user ({ segments := ["I"] }))) [Arg.positional (Expr.ident "t")]) "get") []), Stmt.expr (Expr.call (Expr.member (Expr.call (Expr.typeName (Ty.user ({ segments := ["I"] }))) [Arg.positional (Expr.ident "t")]) "pair") []), Stmt.returnValues (some (Expr.literal (Literal.number "7")))]) })] }

def importedContract : ContractDecl :=
  importedContractDecl1

def importedContracts : List ContractDecl :=
  [importedContractDecl0, importedContractDecl1]

def importedSourceUnit : SourceUnit :=
  { items := [SourceItem.pragma "solidity" "^0.8.0", SourceItem.contract importedContractDecl0, SourceItem.contract importedContractDecl1] }

def importedContractAccepted : Bool :=
  TypeCheck.Result.isOk (TypeCheck.TypecheckedInput.checkedSourceUnit importedSourceUnit)


open SolidCore.Solidity.Source (Value CallResult ScriptedResponder LowLevelCallKind
  LowLevelCallResult State wordEq Word responderOfResults)

def accepted : Bool :=
  TypeCheck.Result.isOk (TypeCheck.TypecheckedInput.checkedSourceUnit importedSourceUnit)

def callC (fn : String) (args : List Value) (responder : ScriptedResponder := []) :
    Except TypeCheck.TypeError CallResult := do
  let program ← TypeCheck.CheckedInput.program importedSourceUnit
  let contract ← TypeCheck.CheckedProgram.contract program "C"
  TypeCheck.CheckedContract.callFunctionWithContextFailOpen 64 responder contract fn
    contract.core.context State.empty args

def returnsWords (r : Except TypeCheck.TypeError CallResult) (expected : List Word) : Bool :=
  match r with
  | .ok (CallResult.returned _ vs) =>
      vs.length == expected.length &&
        (vs.zip expected).all (fun (v, e) =>
          match Value.asWord? v with
          | some w => wordEq w e
          | none => false)
  | _ => false

def reverts (r : Except TypeCheck.TypeError CallResult) : Bool :=
  match r with
  | .ok (CallResult.reverted _ _) => true
  | _ => false

def row (kind : LowLevelCallKind) (sig : String) (tys : List Source.Ty) (args : List Value)
    (outTys : List Source.Ty) (out : List Value) : Except TypeCheck.TypeError LowLevelCallResult := do
  let output ← TypeCheck.Examples.checkedAbiEncodeValues outTys out
  TypeCheck.Examples.checkedHighLevelExternalResult kind sig tys args output

def answers (getOut : List Value) : Except TypeCheck.TypeError ScriptedResponder := do
  let get ← row LowLevelCallKind.call "get()" [] [] (getOut.map (fun _ => Source.Ty.uint256)) getOut
  let pair ← row LowLevelCallKind.call "pair()" [] [] [Source.Ty.uint256, Source.Ty.uint256]
    [Value.word 1, Value.word 2]
  pure (responderOfResults [get, pair] [])

def runWith (getOut : List Value) : Except TypeCheck.TypeError CallResult := do
  callC "f" [Value.word 0xbeef] (← answers getOut)

#guard accepted
#guard returnsWords (runWith [Value.word 40]) [7]
-- Empty (too-short) return data for `get()` reverts in the discarded position too.
#guard reverts (runWith [])

end DiscardedExternalReturn
end Witness
end Solidity
end SolidCore
