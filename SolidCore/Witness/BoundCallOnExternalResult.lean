/-! A `using L for T` bound call whose receiver is an external call result (`IERC20(t).balanceOf(x).sub(r)`) hoists the receiver call before the arguments.

The AST below is generated by `scripts/solc_ast_to_lean_source.py` from:

```solidity
interface IERC20 { function balanceOf(address) external view returns (uint); }
library M { function sub(uint a, uint b) internal pure returns (uint) { require(a >= b); return a - b; } }
contract C { using M for uint; function f(address t, uint r) external view returns (uint) { return IERC20(t).balanceOf(address(this)).sub(r); } }
```
-/

