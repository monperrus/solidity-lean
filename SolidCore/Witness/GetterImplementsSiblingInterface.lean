import SolidCore.Solidity.Checked
import SolidCore.Witness.Checked

/-! A public state variable implementing an interface function reached through another base (`C is IP, E` with `IP is IE`, `E is IE { uint public total; }`) is not an inherited-identifier clash. Without `E is IE` the same names still clash.

The AST below is generated by `scripts/solc_ast_to_lean_source.py` from:

```solidity
interface IE { function total() external view returns (uint); }
interface IP is IE { function factory() external view returns (address); }
contract E is IE { uint public total; }
contract C is IP, E { address public factory; function f() external view returns (uint) { return total + 1; } }
```
-/

namespace SolidCore
namespace Solidity
namespace Witness
namespace GetterImplementsSiblingInterface

def importedSourceName : String := "GetterImplementsSiblingInterface.sol"

def importedContractDecl0 : ContractDecl :=
{ kind := ContractKind.interface
  name := "IE"
  abstract := false
  bases := []
  items := [(ContractItem.function
  { kind := FunctionKind.function,
    name := some "total",
    visibility := some Visibility.external_,
    mutability := StateMutability.view,
    params := [],
    returns := [{ name := none, ty := Ty.uint 256, location := none }],
    virtual := false,
    override? := none,
    modifiers := [],
    body := none })] }

def importedContractDecl1 : ContractDecl :=
{ kind := ContractKind.interface
  name := "IP"
  abstract := false
  bases := [{ base := { segments := ["IE"] }, args := [] }]
  items := [(ContractItem.function
  { kind := FunctionKind.function,
    name := some "factory",
    visibility := some Visibility.external_,
    mutability := StateMutability.view,
    params := [],
    returns := [{ name := none, ty := Ty.address false, location := none }],
    virtual := false,
    override? := none,
    modifiers := [],
    body := none })] }

def importedContractDecl2 : ContractDecl :=
{ kind := ContractKind.contract
  name := "E"
  abstract := false
  bases := [{ base := { segments := ["IE"] }, args := [] }]
  items := [(ContractItem.stateVar
  { name := "total",
    ty := Ty.uint 256,
    visibility := some Visibility.public_,
    mutability := VarMutability.mutable,
    override? := none,
    init := none })] }

def importedContractDecl3 : ContractDecl :=
{ kind := ContractKind.contract
  name := "C"
  abstract := false
  bases := [{ base := { segments := ["IP"] }, args := [] }, { base := { segments := ["E"] }, args := [] }]
  items := [(ContractItem.stateVar
  { name := "factory",
    ty := Ty.address false,
    visibility := some Visibility.public_,
    mutability := VarMutability.mutable,
    override? := none,
    init := none }), (ContractItem.function
  { kind := FunctionKind.function,
    name := some "f",
    visibility := some Visibility.external_,
    mutability := StateMutability.view,
    params := [],
    returns := [{ name := none, ty := Ty.uint 256, location := none }],
    virtual := false,
    override? := none,
    modifiers := [],
    body := some (Stmt.block [Stmt.returnValues (some (Expr.binary BinaryOp.add (Expr.ident "total") (Expr.literal (Literal.number "1"))))]) })] }

def importedContract : ContractDecl :=
  importedContractDecl3

def importedContracts : List ContractDecl :=
  [importedContractDecl0, importedContractDecl1, importedContractDecl2, importedContractDecl3]

def importedSourceUnit : SourceUnit :=
  { items := [SourceItem.pragma "solidity" "^0.8.0", SourceItem.contract importedContractDecl0, SourceItem.contract importedContractDecl1, SourceItem.contract importedContractDecl2, SourceItem.contract importedContractDecl3] }

def importedContractAccepted : Bool :=
  TypeCheck.Result.isOk (TypeCheck.TypecheckedInput.checkedSourceUnit importedSourceUnit)


open SolidCore.Solidity.Source (Value CallResult ScriptedResponder LowLevelCallKind
  LowLevelCallResult State wordEq Word responderOfResults)

def accepted : Bool :=
  TypeCheck.Result.isOk (TypeCheck.TypecheckedInput.checkedSourceUnit importedSourceUnit)

def callC (fn : String) (args : List Value) (responder : ScriptedResponder := []) :
    Except TypeCheck.TypeError CallResult := do
  let program ← TypeCheck.CheckedInput.program importedSourceUnit
  let contract ← TypeCheck.CheckedProgram.contract program "C"
  TypeCheck.CheckedContract.callFunctionWithContextFailOpen 64 responder contract fn
    contract.core.context State.empty args

def returnsWords (r : Except TypeCheck.TypeError CallResult) (expected : List Word) : Bool :=
  match r with
  | .ok (CallResult.returned _ vs) =>
      vs.length == expected.length &&
        (vs.zip expected).all (fun (v, e) =>
          match Value.asWord? v with
          | some w => wordEq w e
          | none => false)
  | _ => false

def reverts (r : Except TypeCheck.TypeError CallResult) : Bool :=
  match r with
  | .ok (CallResult.reverted _ _) => true
  | _ => false

def row (kind : LowLevelCallKind) (sig : String) (tys : List Source.Ty) (args : List Value)
    (outTys : List Source.Ty) (out : List Value) : Except TypeCheck.TypeError LowLevelCallResult := do
  let output ← TypeCheck.Examples.checkedAbiEncodeValues outTys out
  TypeCheck.Examples.checkedHighLevelExternalResult kind sig tys args output

/-- Known negative: `E` no longer derives from `IE`, so `E.total` and `IE.total()`
    are unrelated siblings (solc rejects this too). -/
def unrelatedSiblings : SourceUnit :=
  { importedSourceUnit with
    items := importedSourceUnit.items.map (fun item =>
      match item with
      | SourceItem.contract d =>
          if d.name == "E" then SourceItem.contract { d with bases := [] } else item
      | _ => item) }

#guard accepted
#guard returnsWords (callC "f" []) [1]
#guard TypeCheck.Result.isError (TypeCheck.TypecheckedInput.checkedSourceUnit unrelatedSiblings)

end GetterImplementsSiblingInterface
end Witness
end Solidity
end SolidCore
